# ---------------------------------------------------------------------------
# Authorized Load Tester - example environment
# Copy to .env and fill in real values. NEVER commit a populated .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (web + worker).
DATABASE_URL="postgresql://loadtester:loadtester@localhost:5432/loadtester?schema=public"

# Secret used to sign/verify session material. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-value"

# Session lifetime (seconds). Default 8h.
SESSION_TTL_SECONDS=28800

# ---- Global hard safety ceilings (cannot be exceeded by any target/test) ----
# These are enforced server-side and clamp every per-target value below them.
MAX_GLOBAL_RPS=2000
MAX_GLOBAL_CONCURRENCY=500
MAX_TEST_DURATION=300
# Absolute hard cap on a single request body (bytes).
MAX_PAYLOAD_BYTES=65536
# Maximum number of tests allowed to run concurrently across the platform.
MAX_CONCURRENT_TESTS=5

# ---- Trusted proxy / client IP derivation ----
# One of: none | single | list | vercel
#   none   -> use the raw socket address, ignore all forwarding headers
#   single -> trust exactly one hop; take the last entry of X-Forwarded-For
#   list   -> trust the CIDRs in TRUSTED_PROXIES; walk X-Forwarded-For right-to-left
#   vercel -> trust the platform: use x-real-ip (Vercel overwrites it per request)
TRUSTED_PROXY_MODE=none
# Comma-separated CIDR list, only used when TRUSTED_PROXY_MODE=list
TRUSTED_PROXIES=

# ---- Audit log retention ----
AUDIT_RETENTION_DAYS=365

# ---- Worker (long-lived process model) ----
# Identifier recorded on tests this worker claims. Keep unique per worker process.
WORKER_ID=worker-1
# How often the worker polls for new authorized tests / stop signals (ms).
WORKER_POLL_INTERVAL_MS=1000
# How often aggregated metrics are flushed to the database (ms).
METRICS_FLUSH_INTERVAL_MS=1000

# ---- Worker (serverless / Vercel Cron model) ----
# Set CRON_SECRET in the Vercel project; Vercel Cron sends it as
#   Authorization: Bearer <CRON_SECRET>
# to GET /api/worker/tick. Generate like SESSION_SECRET.
CRON_SECRET=
# Optional separate secret for manually triggering the tick via
#   curl -H "x-worker-secret: <value>" -X POST $APP_URL/api/worker/tick
WORKER_TICK_SECRET=
# Wall-clock budget for one serverless tick. Keep it below the function
# maxDuration for your Vercel plan (Hobby 60s -> use ~50; Pro 300s -> up to ~290).
WORKER_TICK_BUDGET_SECONDS=55

# ---- App ----
NODE_ENV=development
# Public base URL, used for cookie/CORS/Origin checks and reset links.
APP_URL=http://localhost:3000

# ---- Email (password reset) ----
# Optional. Without RESEND_API_KEY the reset flow still issues tokens, but the
# link is written to the server log instead of emailed. `npm run reset-password`
# is the guaranteed offline recovery path regardless.
RESEND_API_KEY=
EMAIL_FROM="Authorized Load Tester <onboarding@resend.dev>"
PASSWORD_RESET_TTL_MINUTES=30
